{
  "name": "playwright-arcade",
  "version": "0.5.0",
  "description": "Retro arcade-style live terminal reporter for Playwright Test",
  "keywords": [
    "playwright",
    "playwright-reporter",
    "reporter",
    "terminal",
    "tui",
    "retro",
    "arcade",
    "testing"
  ],
  "license": "MIT",
  "repository":{
    "type":"git",
    "url":"https://github.com/ajaygoutham1995/playwright-arcade-report"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node scripts/prepublish.js"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0 <2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
